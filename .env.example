# KBTS contact details — leave blank until confirmed by KBTS.
# Blank values render as clearly marked placeholders on the site.

# WhatsApp number in international format, digits only (e.g. 255XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number as it should be displayed
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
# Office / street address
NEXT_PUBLIC_ADDRESS=
# Opening hours, e.g. "Mon–Sat, 08:00–18:00"
NEXT_PUBLIC_HOURS=
# Endpoint that accepts the quote/contact form as JSON (POST). Leave blank until a backend exists.
NEXT_PUBLIC_FORM_ENDPOINT=
# Public site URL used for canonical/OG tags
NEXT_PUBLIC_SITE_URL=
